# Copy to backend/.env and fill in. NEVER commit backend/.env.
DJANGO_SECRET_KEY=replace-me
POSTGRES_USER=continuity
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=continuity
DATABASE_URL=postgres://continuity:replace-me@localhost:5432/continuity
LOG_LEVEL=INFO
AUTH_REGISTRATION_ENABLED=true
API_MAX_REQUEST_BODY_BYTES=2097152

 AI_ENABLED=false
 ANTHROPIC_API_KEY=
 AI_MODEL=
 #Copy BOTH prices (USD per million tokens) from Anthropic's pricing page for the model above.
 AI_PRICE_INPUT_PER_MTOK_USD=
 AI_PRICE_OUTPUT_PER_MTOK_USD=
 AI_MONTHLY_BUDGET_USD=5.00
 AI_MAX_INPUT_CHARS=40000
 AI_MAX_OUTPUT_TOKENS=2000
 AI_REQUEST_TIMEOUT_SECONDS=60